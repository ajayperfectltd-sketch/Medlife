                          <TextRuns>
                            <TextRun>
                              <Value>=Sum(CDec(Switch(Fields!TransType.Value = "payment", "0", Fields!TransType.Value = "Receipt", Fields!Amount.Value)))</Value>
                              <Style>
                                <FontFamily>Verdana</FontFamily>
                                <Format>0.00;(0.00)</Format>
