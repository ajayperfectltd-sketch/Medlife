 Fields!Amount.Value, Fields!TransType.Value = "Receipt", "0")))-(Sum(CDec(Switch(Fields!TransType.Value = "Payment", "0",
 Fields!TransType.Value = "Receipt", Fields!Amount.Value))))&gt;=0,"Debit","Credit")</Value>
                              <Style>
